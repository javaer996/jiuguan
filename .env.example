# ===== 数据库 =====
# 外部 MySQL，数据库不存在时迁移脚本会自动创建（需要 CREATE 权限）
DATABASE_URL="mysql://root:<root-password>@db.example.com:3306/jiuguan"
DB_POOL_SIZE="10"

# ===== 安全密钥 =====
# 会话签名密钥（openssl rand -base64 32）
AUTH_SECRET="<32-byte-base64>"
# API Key 加密密钥（openssl rand -base64 32，必须独立于 AUTH_SECRET）
API_KEY_ENC_SECRET="<32-byte-base64>"

# ===== 首次 seed 的管理员 =====
# ADMIN_PASSWORD 仅在创建管理员时使用；已存在则不会覆盖
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="<strong-password>"
ADMIN_DISPLAY_NAME="酒馆主人"

# ===== 站点 =====
# 对外访问地址，用于 Cookie Secure 判断与 CSRF Origin 校验
APP_URL="http://localhost:3000"
APP_PORT="3000"
# 允许连接私网地址的 AI 供应商（Ollama、局域网 vLLM 等）
ALLOW_PRIVATE_PROVIDER_URLS="false"

# ===== 上传 =====
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="8"
