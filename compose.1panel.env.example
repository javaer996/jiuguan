# 复制本文件为 .env，放在 compose.1panel.yml 同目录后填写。
# .env 不要提交到 Git。

APP_PORT=3000
APP_URL=https://jiuguan.example.com

# MySQL 8。数据库不存在时会自动创建（需要 CREATE 权限）。
# 密码包含 @ : / ? # 等字符时，需要先做 URL 编码。
# 1Panel 的 MySQL 应用若只发布到宿主机，可用 host.docker.internal 或局域网 IP。
DATABASE_URL=mysql://jiuguan:<db-password>@host.docker.internal:3306/jiuguan?charset=utf8mb4
DB_POOL_SIZE=10

# 用 openssl rand -base64 32 生成，两个必须不同，且至少 32 字符。
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_1
API_KEY_ENC_SECRET=REPLACE_WITH_RANDOM_SECRET_2

ADMIN_USERNAME=admin
# 仅在首次 seed 时使用；留空则随机生成，并打印在容器日志里。
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=掌柜

ALLOW_PRIVATE_PROVIDER_URLS=false
MAX_UPLOAD_MB=8

# 代码源；公开仓库无需 token。私有仓库请放在 1Panel 的环境变量里，不要写进本文件。
REPO_URL=https://github.com/javaer996/jiuguan.git
REPO_BRANCH=main
